{
  "name": "cisco-live-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "python3 -m venv .venv && ./.venv/bin/pip install -q -r api/requirements.txt",
    "dev": "astro dev --port 4330",
    "api": "./.venv/bin/uvicorn app.main:app --reload --port 8000 --app-dir api",
    "build": "astro build",
    "preview": "astro preview",
    "start": "./.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir api"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
