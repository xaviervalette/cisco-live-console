---
/**
 * Magnetic's `pol-container-card`: the single surface every block on the
 * canvas sits in. Translucent, blurred, 16px radius, 24px padding, with the
 * inset bevel from --shadow-card.
 *
 * `featured` adds the AI gradient rim — the same p-px trick the marketing
 * archetype uses for its primary button, so emphasis stays one idea.
 *
 * `slot` and `states` are the runtime hooks: the first gives whatever drives
 * the app a stable handle on this card, the second hides it unless the shell's
 * `data-state` is one of the listed values. Both are inert when unset, so a
 * purely static console never pays for them.
 */
import type { Card } from '~/content/app';
interface Props { card: Card; }
const { card } = Astro.props;
---

<section
  class={card.featured ? 'grad-a-bg rounded-[var(--radius-card)] p-px' : ''}
  data-slot={card.slot}
  data-states={card.states?.join(' ')}
>
  <div
    class="blur-card shadow-card flex flex-col gap-4 rounded-[var(--radius-card)] bg-[var(--surface)] p-[var(--card-pad)]"
  >
    {(card.title || card.action) && (
      <header class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
          {card.title && (
            <h2 class="font-heading text-[16px] leading-[22px] font-bold text-[var(--ink)]">{card.title}</h2>
          )}
          {/* Addressable so runtime code can say what the data covers — the
              edition, the export's date — without rebuilding the header. */}
          {card.subtitle && (
            <p data-card-subtitle class="text-[14px] leading-[20px] text-[var(--ink-muted)]">{card.subtitle}</p>
          )}
        </div>
        {card.action && (
          <a
            href={card.action.href}
            class="shrink-0 rounded-[var(--radius-button)] px-2 py-1 text-[14px] leading-[20px] font-semibold text-[var(--primary)] transition-colors hover:bg-[var(--surface-2)]"
          >
            {card.action.label}
          </a>
        )}
      </header>
    )}
    <slot />
  </div>
</section>
