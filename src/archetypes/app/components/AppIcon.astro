---
/**
 * The icon set for the app shell.
 *
 * ADDING AN ICON — one line in the table below. Paths are drawn on a 24x24
 * grid with a 1.6 stroke, which is what keeps them visually consistent with
 * Magnetic's own set. A name that is not in the table renders a dashed
 * placeholder rather than nothing, so a typo is obvious instead of silent.
 */
import type { AppIconName } from '~/content/app';

interface Props { name: AppIconName; class?: string; }
const { name, class: className = 'size-6' } = Astro.props;

/** name -> { d: inner SVG markup, viewBox?: override } */
const ICONS: Record<string, { d: string; viewBox?: string }> = {
  'home': { d: `<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>` },
  'grid': { d: `<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>` },
  'chart': { d: `<path d="M3 21h18"/><rect x="5" y="11" width="3.5" height="7" rx="1"/><rect x="10.2" y="6" width="3.5" height="12" rx="1"/><rect x="15.5" y="13" width="3.5" height="5" rx="1"/>` },
  'book': { d: `<path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H19v16H5.5A1.5 1.5 0 0 0 4 20.5z"/><path d="M4 17.5A1.5 1.5 0 0 1 5.5 16H19"/>` },
  'layers': { d: `<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>` },
  'file': { d: `<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>` },
  'search': { d: `<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>` },
  'bell': { d: `<path d="M18 8a6 6 0 1 0-12 0c0 6-2 7-2 7h16s-2-1-2-7"/><path d="M13.7 20a2 2 0 0 1-3.4 0"/>` },
  'help': { d: `<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.3 2.4c-.6.2-.8.7-.8 1.3v.3"/><circle cx="12" cy="17" r=".6" fill="currentColor"/>` },
  'settings': { d: `<circle cx="12" cy="12" r="3"/><path d="M19.4 14.5a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0 1.6 1.6 0 0 0-2.8-1.1l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.6 1.6 0 0 0 3 14.5a2 2 0 1 1 0-4 1.6 1.6 0 0 0 1.1-2.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.6 1.6 0 0 0 9.6 3 2 2 0 1 1 13.6 3a1.6 1.6 0 0 0 2.8 1.1l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0 1.1 2.8 2 2 0 1 1 0 4 1.6 1.6 0 0 0-.9.8"/>` },
  'chevron': { d: `<path d="m6 9 6 6 6-6"/>` },
  'sparkle': { d: `<path d="M12 3.5 13.8 9l5.7 1.8-5.7 1.8L12 18.3l-1.8-5.7L4.5 10.8 10.2 9z"/><path d="M18.5 15.5 19.3 18l2.2.8-2.2.8-.8 2.4-.8-2.4-2.2-.8 2.2-.8z"/>` },
  'plus': { d: `<path d="M12 5v14M5 12h14"/>` },
  'arrow': { d: `<path d="M5 12h14M12 5l7 7-7 7"/>` },
  'check': { d: `<path d="M20 6 9 17l-5-5"/>` },
  'dot': { d: `<circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"/>` },
  'menu': { d: `<path d="M4 6h16M4 12h16M4 18h16"/>` },
  'sliders': { d: `<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>` },
  'diff': { d: `<path d="M5 4v12a2 2 0 0 0 2 2h5"/><path d="m9 15 3 3-3 3"/><path d="M19 20V8a2 2 0 0 0-2-2h-5"/><path d="m15 9-3-3 3-3"/>` },
  'inspect': { d: `<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M11 8v6M8 11h6"/>` },
  'clock': { d: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>` },
  'upload': { d: `<path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>` },
  'download': { d: `<path d="M12 4v12"/><path d="m7 11 5 5 5-5"/><path d="M4 18v1a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1"/>` },
  'key': { d: `<circle cx="8" cy="12" r="4"/><path d="M12 12h9l-2 2.5M17.5 12v3"/>` },
  'table': { d: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>` },
  'trash': { d: `<path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/><path d="M10 11v6M14 11v6"/>` },
  'users': { d: `<circle cx="9" cy="8" r="3.4"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><path d="M16 5.3a3.4 3.4 0 0 1 0 6.4"/><path d="M18 14.9c2 .8 3 2.6 3 5.1"/>` },
  'ticket': { d: `<path d="M3 9.5V7a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v2.5a2.5 2.5 0 0 0 0 5V17a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2.5a2.5 2.5 0 0 0 0-5"/><path d="M12 7v10" stroke-dasharray="2 2"/>` },
  'coin': { d: `<ellipse cx="12" cy="7" rx="7.5" ry="3.2"/><path d="M4.5 7v5c0 1.8 3.4 3.2 7.5 3.2s7.5-1.4 7.5-3.2V7"/><path d="M4.5 12v5c0 1.8 3.4 3.2 7.5 3.2s7.5-1.4 7.5-3.2v-5"/>` },
  'calendar': { d: `<rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>` },
  'refresh': { d: `<path d="M20 11a8 8 0 0 0-13.7-5.3L3 9"/><path d="M4 13a8 8 0 0 0 13.7 5.3L21 15"/><path d="M3 4v5h5M21 20v-5h-5"/>` },
  'warning': { d: `<path d="M10.3 4.3 2.8 17.2A1.6 1.6 0 0 0 4.2 19.6h15.6a1.6 1.6 0 0 0 1.4-2.4L13.7 4.3a1.6 1.6 0 0 0-2.8 0z"/><path d="M12 9.5v4"/><circle cx="12" cy="16.4" r=".6" fill="currentColor"/>` },
};

const icon = ICONS[name];
const viewBox = icon?.viewBox ?? '0 0 24 24';
---

{icon ? (
  <svg
    viewBox={viewBox}
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={`shrink-0 ${className}`}
    set:html={icon.d}
  />
) : (
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={`shrink-0 ${className}`}>
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 3" opacity="0.5" />
  </svg>
)}
